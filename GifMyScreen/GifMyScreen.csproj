<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<!-- Sistem Tepsisi (NotifyIcon) için gerekli: -->
	<UseWindowsForms>true</UseWindowsForms>
	<!-- 24H2+ masaüstü enjeksiyonu için gereken supportedOS bildirimi: -->
	<ApplicationManifest>app.manifest</ApplicationManifest>
	<!-- WFO0003: WinForms analizcisi DPI ayarını manifest yerine Application.SetHighDpiMode ile önerir; bu bir WPF uygulamasıdır,
	     WinForms yalnızca NotifyIcon için kullanılır. WPF'te Per-Monitor V2 için belgelenmiş yöntem manifesttir. -->
	<NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
